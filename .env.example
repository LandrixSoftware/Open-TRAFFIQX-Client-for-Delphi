# Beispielkonfiguration für TIA/TRAFFIQX
# Kopiere diese Datei nach `.env` und trage echte Werte ein.
# Achtung: Keine echten Secrets commiten!

# Broker-Konfiguration
# URL des eigenen Brokers (siehe OAuth2-Broker/README.md)
OAUTH2_BROKER_CALLBACK_URI=https://broker.example.com/callback.php
OAUTH2_BROKER_API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY

# Provider: tpB4Value (QS)
PROVIDER_TPB4VALUE_CLIENT_ID=your-client-id
PROVIDER_TPB4VALUE_CLIENT_SECRET=
PROVIDER_TPB4VALUE_TRAFFIQX_ID=0000000000000
PROVIDER_TPB4VALUE_SCOPE=openid traffiqx:invoice offline_access

# Provider: tpDatev (Sandbox)
PROVIDER_TPDATEV_CLIENT_ID=your-client-id
PROVIDER_TPDATEV_CLIENT_SECRET=
PROVIDER_TPDATEV_TRAFFIQX_ID=0000000000000
PROVIDER_TPDATEV_SCOPE=openid traffiqx:invoice
PROVIDER_TPDATEV_APP_NAME=App-Name-laut-DATEV

# Provider: tpDatevSmartTransfer
PROVIDER_TPDATEVSMARTTRANSFER_CLIENT_ID=
PROVIDER_TPDATEVSMARTTRANSFER_CLIENT_SECRET=
PROVIDER_TPDATEVSMARTTRANSFER_TRAFFIQX_ID=
PROVIDER_TPDATEVSMARTTRANSFER_SCOPE=openid traffiqx:invoice
PROVIDER_TPDATEVSMARTTRANSFER_APP_NAME=

# Provider: tpBundesdruckerei
PROVIDER_TPBUNDESDRUCKEREI_CLIENT_ID=
PROVIDER_TPBUNDESDRUCKEREI_CLIENT_SECRET=
PROVIDER_TPBUNDESDRUCKEREI_TRAFFIQX_ID=
PROVIDER_TPBUNDESDRUCKEREI_SCOPE=openid traffiqx:invoice

# Provider: tpBeCloud
PROVIDER_TPBCLOUD_CLIENT_ID=
PROVIDER_TPBCLOUD_CLIENT_SECRET=
PROVIDER_TPBCLOUD_TRAFFIQX_ID=
PROVIDER_TPBCLOUD_SCOPE=openid traffiqx:invoice

# Provider: tpExelaAsterion
PROVIDER_TPEXELAASTERION_CLIENT_ID=
PROVIDER_TPEXELAASTERION_CLIENT_SECRET=
PROVIDER_TPEXELAASTERION_TRAFFIQX_ID=
PROVIDER_TPEXELAASTERION_SCOPE=openid traffiqx:invoice

# Provider: tpQuadient
PROVIDER_TPQUADIENT_CLIENT_ID=
PROVIDER_TPQUADIENT_CLIENT_SECRET=
PROVIDER_TPQUADIENT_TRAFFIQX_ID=
PROVIDER_TPQUADIENT_SCOPE=openid traffiqx:invoice

# Provider: tpSGHService
PROVIDER_TPSGHSERVICE_CLIENT_ID=
PROVIDER_TPSGHSERVICE_CLIENT_SECRET=
PROVIDER_TPSGHSERVICE_TRAFFIQX_ID=
PROVIDER_TPSGHSERVICE_SCOPE=openid traffiqx:invoice

# Provider: tpRicoh
PROVIDER_TPRICOH_CLIENT_ID=
PROVIDER_TPRICOH_CLIENT_SECRET=
PROVIDER_TPRICOH_TRAFFIQX_ID=
PROVIDER_TPRICOH_SCOPE=openid traffiqx:invoice

# Nur zum Erzeugen der XRechnung-Testfaelle im Sample:
# Distribution-Verzeichnis von XRechnung-for-Delphi (Java, Validator, Visualisierung)
XRECHNUNG_DISTRIBUTION_DIR=
